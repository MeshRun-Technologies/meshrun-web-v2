# Early access form. Copy to .env.local for local work, and set the same
# variables in Vercel (Project → Settings → Environment Variables).
#
# Each submission goes to every destination configured below. With none set,
# the dev server saves them to .data/early-access.jsonl, and production
# answers 503 so a missing setup can't silently swallow requests.

# --- Keep each one in Vercel Blob -------------------------------------------
# Set automatically when a Blob store is linked to the project (Storage tab).
# Locally, `vercel env pull .env.local` fetches it; leave it unset to keep
# dev submissions in the local file instead.
BLOB_READ_WRITE_TOKEN=

# --- Email the team, through Resend (resend.com) ----------------------------
# The FROM address must be on a domain verified in Resend.
RESEND_API_KEY=
EARLY_ACCESS_FROM="MeshRun <early-access@meshrun.co>"
# Comma-separated. Replies go straight to the person who filled in the form.
EARLY_ACCESS_TO=info@meshrun.co
# "true" also sends the visitor a short thank-you, if they left an email.
EARLY_ACCESS_CONFIRM=false

# --- Or post it somewhere ---------------------------------------------------
# Slack or Discord incoming webhooks get a formatted message. Any other URL
# (Zapier, Make, a Google Apps Script web app writing to a Sheet, your own
# API) receives the full record as JSON.
EARLY_ACCESS_WEBHOOK_URL=
# Sent as "Authorization: Bearer …" to that URL, if your endpoint checks one.
EARLY_ACCESS_WEBHOOK_SECRET=

# --- Client -----------------------------------------------------------------
# Only if the form should post somewhere other than this site's own
# /api/early-access.
# VITE_EARLY_ACCESS_ENDPOINT=
